{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResoFit External Business Source",
  "type": "object",
  "required": ["source_key", "business_name", "business_type", "source_url", "verification_status", "partnership_status", "ingest_status"],
  "properties": {
    "source_key": {"type": "string", "description": "Stable normalized deduplication key"},
    "business_name": {"type": "string"},
    "business_type": {"type": "string"},
    "categories": {"type": "array", "items": {"type": "string"}},
    "country": {"type": "string"},
    "state": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "lga": {"type": ["string", "null"]},
    "address": {"type": ["string", "null"]},
    "postcode": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "website_url": {"type": ["string", "null"], "format": "uri"},
    "booking_url": {"type": ["string", "null"], "format": "uri"},
    "google_business_url": {"type": ["string", "null"], "format": "uri"},
    "google_place_id": {"type": ["string", "null"]},
    "email": {"type": ["string", "null"], "format": "email"},
    "phone": {"type": ["string", "null"]},
    "whatsapp": {"type": ["string", "null"]},
    "social_links": {"type": "object", "additionalProperties": {"type": "string", "format": "uri"}},
    "services": {"type": "array", "items": {"type": "string"}},
    "commerce_capabilities": {"type": "array", "items": {"type": "string"}},
    "source_url": {"type": "string", "format": "uri"},
    "source_name": {"type": ["string", "null"]},
    "source_evidence": {"type": "object"},
    "metadata": {"type": "object"},
    "verification_status": {"enum": ["discovered", "public_source_checked", "contact_verified", "business_verified", "rejected"]},
    "partnership_status": {"enum": ["prospect", "contacted", "onboarding", "contracted", "active", "paused", "rejected"]},
    "ingest_status": {"enum": ["queued", "enriched", "needs_review", "approved", "published", "failed"]},
    "last_checked_at": {"type": ["string", "null"], "format": "date-time"},
    "last_contacted_at": {"type": ["string", "null"], "format": "date-time"},
    "owner_email": {"type": ["string", "null"], "format": "email"}
  }
}
